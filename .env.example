# ===========================================
# Wolff Environment Variables (root — used by Docker)
# ===========================================
# For Next.js development, use apps/web/.env.example instead:
#   cp apps/web/.env.example apps/web/.env.local

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "true" to skip email verification on login (local dev only, never set in production/Vercel)
SKIP_EMAIL_VERIFICATION=true
NEXT_PUBLIC_APP_NAME=Wolff

# Database (PostgreSQL)
DATABASE_URL="postgresql://wolff:wolff_dev_only@localhost:5432/wolff?schema=public"
SHADOW_DATABASE_URL="postgresql://wolff:wolff_dev_only@localhost:5432/wolff_shadow?schema=public"

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET= # Generate with: openssl rand -base64 32

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Wolff <noreply@quote.persuado.tech>"
# Free demo only: DEMO_MODE=true sends every email to DEMO_EMAIL_REDIRECT
# (intended recipients go in the subject). The app refuses to start in demo
# mode without it.
DEMO_MODE=false
DEMO_EMAIL_REDIRECT=
EMAIL_REPLY_TO=

# File Storage
# Options: 'local', 's3', or 'cloudflare'
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_URL=/uploads

# S3/Cloudflare R2 Storage (if STORAGE_PROVIDER=s3 or cloudflare)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT= # Required for Cloudflare R2

# PDF Generation
# Puppeteer settings for PDF generation
PUPPETEER_EXECUTABLE_PATH= # Optional, path to Chrome/Chromium

# Redis (BullMQ queues and API rate-limit counters)
REDIS_URL=redis://localhost:6379

# Jobs dispatcher: 'bullmq' (local/ECS, needs REDIS_URL) or 'qstash' (demo)
JOB_DISPATCHER=bullmq

# QStash (only when JOB_DISPATCHER=qstash)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# API public URL (used by QStash and links)
PUBLIC_API_URL=http://localhost:4000

# Rate Limiting
RATE_LIMIT_WINDOW=60000 # 1 minute in ms
RATE_LIMIT_MAX_REQUESTS=100

# Observability
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
GIT_SHA=

# Logging
LOG_LEVEL=debug # debug, info, warn, error

# -----------------------------------------------------------------------------
# AI service (services/ai). Leave AI_URL empty to run without it:
# the assistant is hidden and nothing else changes.
# -----------------------------------------------------------------------------
# Web app and apps/api: where the AI service listens.
AI_URL=
# One HS256 secret per calling service; at least 32 random bytes each.
SVC_JWT_SECRET_WEB=
SVC_JWT_SECRET_WORKER=
SVC_JWT_SECRET_AI=
# The AI service's own settings.
AI_DB_PASSWORD=
AI_DATABASE_URL=postgresql://ai_service:${AI_DB_PASSWORD}@localhost:5432/wolff
API_INTERNAL_URL=http://localhost:4000
AI_PUBLIC_URL=http://localhost:8000
# gemini (free tier, demo default) | openai (production) | fake (offline, tests only)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional overrides: AI_CHAT_MODEL, AI_EMBED_MODEL, AI_MODEL_ALLOWLIST (comma-separated)
AI_DAILY_BUDGET_USD=0.50
AI_MAX_TOKENS=1024
AI_REPORTS_DIR=var/reports
