{
  "name": "@wolff/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.exclude='**/*.test.*' --coverage.exclude='**/generated/**' --coverage.exclude='**/testing/**' --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "build": "tsc",
    "build:vercel": "node scripts/bundle-vercel.mjs && tsx scripts/check-vercel-output.ts bundle .vercel-bundle",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "worker:drain": "tsx src/worker-drain.ts",
    "schedules:sync": "tsx scripts/sync-qstash-schedules.ts",
    "backup:restore": "tsx scripts/restore-backup.ts",
    "openapi:gen": "tsx scripts/generate-openapi.ts && prettier --write openapi.json",
    "openapi:postman": "tsx scripts/generate-postman.ts",
    "check:vercel-output": "tsx scripts/check-vercel-output.ts output ../../.vercel/output",
    "schemathesis": "bash scripts/schemathesis.sh"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@wolff/contracts": "workspace:*",
    "@wolff/core": "workspace:*",
    "@wolff/database": "workspace:*",
    "@wolff/jobs": "workspace:*",
    "@scalar/express-api-reference": "0.10.35",
    "@sentry/node": "11.11.0",
    "@upstash/qstash": "2.12.1",
    "bullmq": "6.7.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "pino": "^10.4.0",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.2",
    "razorpay": "2.9.8",
    "stripe": "22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "^0.28.2",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
