{
  "name": "@wolff/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "worker:drain": "tsx src/worker-drain.ts",
    "openapi:gen": "tsx scripts/generate-openapi.ts",
    "openapi:postman": "npx openapi-to-postmanv2 -s openapi.json -o ../../docs/api/postman_collection.json -p"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@wolff/contracts": "workspace:*",
    "@wolff/core": "workspace:*",
    "@wolff/database": "workspace:*",
    "@wolff/jobs": "workspace:*",
    "@scalar/express-api-reference": "0.10.25",
    "@sentry/node": "11.1.0",
    "@upstash/qstash": "2.12.0",
    "bullmq": "6.3.10",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "pino": "^10.3.1",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.1",
    "stripe": "22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "7.3.0",
    "testcontainers": "12.2.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
