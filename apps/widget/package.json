{
  "name": "@wolff/widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/sri.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.exclude='**/*.test.*' --coverage.exclude='**/generated/**' --coverage.exclude='**/testing/**' --coverage.reporter=text-summary --coverage.reporter=json-summary",
    "size": "size-limit"
  },
  "dependencies": {
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@preact/preset-vite": "^2.10.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/preact": "^3.2.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.20.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "size-limit": "^11.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "size-limit": [
    {
      "path": "dist/widget.iife.js",
      "limit": "60 kB",
      "gzip": true
    },
    {
      "path": "dist/widget.es.js",
      "limit": "60 kB",
      "gzip": true
    }
  ]
}
