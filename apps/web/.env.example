# ===========================================
# Wolff Web App Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Wolff

# Database (PostgreSQL)
DATABASE_URL="postgresql://wolff:wolff@localhost:5432/wolff?schema=public"

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET= # Generate with: openssl rand -base64 32

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tests/CI only: send Stripe API calls to stripe-mock, e.g. http://localhost:12111
# STRIPE_API_BASE_URL=
# Low #36: Removed STRIPE_PUBLISHABLE_KEY (wrong name). Use NEXT_PUBLIC_ version below.

# Email — choose one provider
# Option 1: Resend (recommended)
RESEND_API_KEY=
EMAIL_FROM=noreply@wolff.dev
# Free demo only: DEMO_MODE=true sends every email to DEMO_EMAIL_REDIRECT
# (intended recipients go in the subject). The app refuses to start in demo
# mode without it.
DEMO_MODE=false
DEMO_EMAIL_REDIRECT=
EMAIL_REPLY_TO=

# Option 2: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# File Storage
STORAGE_PROVIDER=local          # local | s3 | r2
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_PUBLIC_URL=

# Stripe (public key for client-side checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Demo Mode (optional)
DEMO_USER_EMAIL=

# Cron Jobs (optional — secret for /api/cron endpoints)
CRON_SECRET=

# PDF Generation (optional — Puppeteer path override)
# PUPPETEER_EXECUTABLE_PATH=

# Social Links (optional — shown in landing page footer)
# NEXT_PUBLIC_GITHUB_URL=https://github.com/theCodeForgerHQ/wolff
# NEXT_PUBLIC_TWITTER_URL=
# NEXT_PUBLIC_DISCORD_URL=
# NEXT_PUBLIC_LINKEDIN_URL=

# Sentry (optional). Leave empty to keep the SDK disabled: nothing is sent.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Source map upload at build time (release pipelines only)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
