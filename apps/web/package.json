{
  "name": "@wolff/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e:seed": "npx tsx -r dotenv/config e2e/utils/seed-e2e-data.ts",
    "e2e:cleanup": "CLEANUP=true npx tsx -r dotenv/config e2e/utils/seed-e2e-data.ts",
    "e2e:seed:edge-cases": "SEED_EDGE_CASES=true npx tsx -r dotenv/config e2e/utils/seed-e2e-data.ts",
    "e2e:data-integrity": "playwright test --project=data-integrity",
    "e2e:regression": "playwright test --project=regression",
    "e2e:full": "pnpm e2e:seed:edge-cases && pnpm test:e2e"
  },
