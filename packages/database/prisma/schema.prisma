  razorpayWebhookSecretEnc  String?           @map("razorpay_webhook_secret_enc") @db.Text
  razorpayVerifiedAt        DateTime?         @map("razorpay_verified_at")
  defaultProviderByCurrency Json              @default("{\"*\":\"stripe\"}") @map("default_provider_by_currency")
  passProcessingFees        Boolean           @default(false) @map("pass_processing_fees")
