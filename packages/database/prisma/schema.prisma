// ============================================
// CREDIT NOTES
// ============================================

model CreditNote {
  id               String      @id @default(uuid())
  workspaceId      String      @map("workspace_id")
  invoiceId        String      @map("invoice_id")
  creditNoteNumber String      @map("credit_note_number") @db.VarChar(50)
  reason           String      @db.Text
  amount           Decimal     @db.Decimal(12, 2)
  currency         String      @default("USD") @db.VarChar(3)
  status           String      @default("draft") @db.VarChar(20)
  issuedAt         DateTime?   @map("issued_at")
  notes            String?     @db.Text
  placeOfSupply    String?     @map("place_of_supply") @db.VarChar(2)
  supplyType       SupplyType? @map("supply_type")
  reverseCharge    Boolean     @default(false) @map("reverse_charge")
  supplierGstin    String?     @map("supplier_gstin") @db.VarChar(15)
  recipientGstin   String?     @map("recipient_gstin") @db.VarChar(15)
  taxBreakup       Json?       @map("tax_breakup")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  lineItems CreditNoteLineItem[]
  events    CreditNoteEvent[]

  @@unique([workspaceId, creditNoteNumber])
  @@index([workspaceId])
  @@index([invoiceId])
  @@map("credit_notes")
}

model CreditNoteLineItem {
  id           String   @id @default(uuid())
  creditNoteId String   @map("credit_note_id")
  name         String
  description  String?  @db.Text
  quantity     Decimal  @default(1) @db.Decimal(10, 2)
  rate         Decimal  @db.Decimal(12, 2)
  amount       Decimal  @db.Decimal(12, 2)
  hsnSac       String?  @map("hsn_sac") @db.VarChar(8)
  itemType     ItemType @default(services) @map("item_type")
  gstRate      Decimal? @map("gst_rate") @db.Decimal(5, 2)
  taxableValue Decimal  @default(0) @map("taxable_value") @db.Decimal(12, 2)
  cgstRate     Decimal? @map("cgst_rate") @db.Decimal(5, 2)
  cgstAmount   Decimal  @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstRate     Decimal? @map("sgst_rate") @db.Decimal(5, 2)
  sgstAmount   Decimal  @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstRate     Decimal? @map("igst_rate") @db.Decimal(5, 2)
  igstAmount   Decimal  @default(0) @map("igst_amount") @db.Decimal(12, 2)
  cessAmount   Decimal  @default(0) @map("cess_amount") @db.Decimal(12, 2)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at") // Low #4

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
  @@map("credit_note_line_items")
}

model CreditNoteEvent {
  id           String   @id @default(uuid())
  creditNoteId String   @map("credit_note_id")
  eventType    String   @map("event_type") @db.VarChar(50)
  actorId      String?  @map("actor_id")
  actorType    String   @default("user") @map("actor_type") @db.VarChar(20)
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([creditNoteId])
  @@map("credit_note_events")
}

// ============================================
// SAVED LINE ITEMS (reusable items for quotes/invoices)
// ============================================

model SavedLineItem {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String   @db.VarChar(200)
  description String?  @db.Text
  price       Decimal  @default(0) @db.Decimal(12, 2)
  duration    String?  @db.VarChar(20)
  taxable     Boolean  @default(true)
  hsnSac      String?  @map("hsn_sac") @db.VarChar(8)
  itemType    ItemType @default(services) @map("item_type")
  gstRate     Decimal? @map("gst_rate") @db.Decimal(5, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("saved_line_items")
}

// ============================================
// API KEYS
// ============================================

model ApiKey {
  id              String     @id @default(uuid())
  workspaceId     String     @map("workspace_id")
  name            String     @db.VarChar(100)
  keyHash         String     @unique @map("key_hash")
  keyPrefix       String     @map("key_prefix") @db.VarChar(12)
  // Secret keys act for the workspace from a server. Publishable keys are
  // embedded in a browser, so they carry an origin allowlist and may only
  // hold the two public scopes.
  kind            ApiKeyKind @default(secret)
  scopes          String[]   @default([])
  allowedOrigins  String[]   @default([]) @map("allowed_origins")
  rateLimitPerMin Int        @default(120) @map("rate_limit_per_min")
  lastUsedAt      DateTime?  @map("last_used_at")
  expiresAt       DateTime?  @map("expires_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  revokedAt       DateTime?  @map("revoked_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
}

enum ApiKeyKind {
  secret
  publishable

  @@map("api_key_kind")
}

// ============================================
// API WRITE PATH: OUTBOX, INBOUND WEBHOOK EVENTS, IDEMPOTENCY
// ============================================

enum PaymentProvider {
  stripe
  razorpay

  @@map("payment_provider")
}

enum WebhookEventStatus {
  received
  processed
  failed

  @@map("webhook_event_status")
}

// One row per event a payment provider delivered. The unique key is what
// makes a provider retry, or the same event arriving at two endpoints,
// processed once.
model ProviderWebhookEvent {
  id          String             @id @default(uuid())
  provider    PaymentProvider
  eventId     String             @map("event_id") @db.VarChar(255)
  type        String             @db.VarChar(100)
  payload     Json?
  status      WebhookEventStatus @default(received)
  lastError   String?            @map("last_error") @db.Text
  receivedAt  DateTime           @default(now()) @map("received_at")
  processedAt DateTime?          @map("processed_at")

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("provider_webhook_events")
}

enum OutboxStatus {
  pending
  enqueued
  done
  failed

  @@map("outbox_status")
}

// Transactional outbox: written in the same transaction as the
// business change, relayed to the job queue afterwards. The database is the
// record; the queue can be lost and refilled from these rows.
model OutboxEvent {
  id            String       @id @default(uuid())
  // Null only for events whose workspace is not known when they are written
  // (an inbound provider webhook before it is reconciled).
  workspaceId   String?      @map("workspace_id")
  type          String       @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(50)
  aggregateId   String       @map("aggregate_id")
  payload       Json         @default("{}")
  status        OutboxStatus @default(pending)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at")
  enqueuedAt    DateTime?    @map("enqueued_at")
  doneAt        DateTime?    @map("done_at")
  lastError     String?      @map("last_error") @db.Text
  traceId       String?      @map("trace_id") @db.VarChar(64)
  createdAt     DateTime     @default(now()) @map("created_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model JobRun {
  id          String    @id @default(uuid())
  queue       String    @db.VarChar(50)
  jobId       String    @map("job_id") @db.VarChar(100)
  name        String    @db.VarChar(100)
  workspaceId String?   @map("workspace_id")
  status      String    @db.VarChar(20)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error") @db.Text
  startedAt   DateTime? @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([queue, status])
  @@index([workspaceId])
  @@index([jobId])
  @@map("job_runs")
}

// A stored response for an `Idempotency-Key` header, replayed for 24 hours.
model IdempotencyKey {
  id             String   @id @default(uuid())
  workspaceId    String   @map("workspace_id")
  key            String   @db.VarChar(255)
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(500)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ============================================
// INVOICE TEMPLATES
// ============================================

model InvoiceTemplate {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  name         String    @db.VarChar(200)
  description  String?   @db.Text
  paymentTerms String    @default("net30") @map("payment_terms") @db.VarChar(20)
  currency     String    @default("USD") @db.VarChar(3)
  lineItems    Json      @default("[]") @map("line_items")
  notes        String?   @db.Text
  terms        String?   @db.Text
  isDefault    Boolean   @default(false) @map("is_default")
  usageCount   Int       @default(0) @map("usage_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, deletedAt])
  @@map("invoice_templates")
}

// ============================================
// FOLLOW-UP AUTOMATIONS
// ============================================

model Automation {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  name        String   @db.VarChar(200)
  trigger     String   @db.VarChar(50)
  steps       Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AutomationRun[]

  @@index([workspaceId, isActive])
  @@map("automations")
}

model AutomationRun {
  id            String    @id @default(uuid())
  workspaceId   String    @map("workspace_id")
  automationId  String    @map("automation_id")
  subjectId     String    @map("subject_id")
  currentStep   Int       @default(0) @map("current_step")
  status        String    @default("running") @db.VarChar(20)
  log           Json      @default("[]")
  waitingSince  DateTime? @map("waiting_since")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([automationId, status])
  @@index([subjectId])
  @@map("automation_runs")
}

// ============================================
// OUTBOUND WEBHOOKS
// ============================================

model WebhookEndpoint {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  name         String    @default("") @db.VarChar(200)
  url          String    @db.VarChar(500)
  // AES-256-GCM ciphertext of the signing secret (about 120 characters).
  secret       String    @db.Text
  events       String[]  @default([])
  isActive     Boolean   @default(true) @map("is_active")
  // The version of the payload format this endpoint receives.
  apiVersion   String    @default("2026-10") @map("api_version") @db.VarChar(10)
  // Deliveries in a row that used all their attempts. 20 disables the endpoint.
  failureCount Int       @default(0) @map("failure_count")
  disabledAt   DateTime? @map("disabled_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String    @id @default(uuid())
  endpointId  String    @map("endpoint_id")
  // Copied from the endpoint; nullable for the same reason as on Payment.
  workspaceId String?   @map("workspace_id")
  eventType   String    @map("event_type") @db.VarChar(50)
  payload     Json
  status      String    @default("pending") @db.VarChar(20)
  statusCode  Int?      @map("status_code")
  response    String?   @db.Text
  attempts    Int       @default(0)
  nextRetry   DateTime? @map("next_retry")
  createdAt   DateTime  @default(now()) @map("created_at")

  endpoint  WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  workspace Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([workspaceId, createdAt])
  @@index([status, nextRetry])
  @@map("webhook_deliveries")
}
