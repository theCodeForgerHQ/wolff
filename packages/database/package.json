{
  "name": "@wolff/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "prisma generate",
    "generate": "prisma generate",
    "push": "prisma db push",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:prod": "tsx prisma/seed-production.ts",
    "seed:e2e": "tsx prisma/seed-e2e-production.ts",
    "seed:e2e:cleanup": "tsx prisma/seed-e2e-production.ts --cleanup",
    "seed:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "backfill:api-key-scopes": "tsx scripts/backfill-api-key-scopes.ts"
  },
  "dependencies": {
    "@wolff/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "7.10.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
