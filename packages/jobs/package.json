{
  "name": "@wolff/jobs",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./bullmq": "./src/bullmq.ts",
    "./qstash": "./src/qstash.ts",
    "./testing/redis": "./src/testing/redis.ts",
    "./ports": "./src/ports/index.ts",
    "./backup": "./src/backup.ts",
    "./backup-cipher": "./src/backup-cipher.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.exclude='**/*.test.*' --coverage.exclude='**/generated/**' --coverage.exclude='**/testing/**' --coverage.reporter=text-summary --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@wolff/contracts": "workspace:*",
    "@wolff/core": "workspace:*",
    "@wolff/database": "workspace:*",
    "@sparticuz/chromium": "153.0.0",
    "@upstash/qstash": "2.12.1",
    "bullmq": "6.7.1",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "puppeteer-core": "25.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.1.0",
    "testcontainers": "12.2.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
